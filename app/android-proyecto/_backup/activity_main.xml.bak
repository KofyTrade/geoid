<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generador VLESS"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="v1.0 · VPN real con seleccion de apps"
            android:textSize="13sp" />

        <!-- ============ VPN ============ -->

        <TextView
            android:id="@+id/tvVpnEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="VPN desactivada"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVpn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Conectar VPN" />

        <Button
            android:id="@+id/btnApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elegir aplicaciones" />

        <TextView
            android:id="@+id/tvAppsResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Apps con VPN: todas"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbAnuncios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Bloquear anuncios" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:background="#22000000" />

        <!-- ============ DATOS DEL SERVIDOR ============ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pega aquí tu enlace y pulsa Importar"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etImportar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="vless://..."
            android:inputType="textNoSuggestions"
            android:minLines="2"
            android:maxLines="4" />

        <Button
            android:id="@+id/btnImportar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Importar enlace" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre (ej. mi-vps)"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Servidor: IP o dominio"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etPuerto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Puerto"
            android:inputType="number"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etUuid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="UUID"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etPbk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Clave publica (pbk) — 43 caracteres"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etSid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Short ID (sid)"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etSni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SNI (ej. www.microsoft.com)"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Enlace resultante"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEnlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCopiar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:text="Copiar enlace" />

        <Button
            android:id="@+id/btnRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ver registro (diagnostico)" />

    </LinearLayout>
</ScrollView>
