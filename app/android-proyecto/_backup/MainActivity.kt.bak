package com.kofy.vlessgen

import android.Manifest
import android.app.AlertDialog
import android.content.BroadcastReceiver
import android.content.ClipData
import android.content.ClipboardManager
import android.content.Context
import android.content.Intent
import android.content.IntentFilter
import android.content.pm.PackageManager
import android.net.VpnService
import android.os.Build
import android.os.Bundle
import android.text.Editable
import android.text.TextWatcher
import android.widget.Button
import android.widget.CheckBox
import android.widget.EditText
import android.widget.ScrollView
import android.widget.TextView
import android.widget.Toast
import androidx.activity.result.contract.ActivityResultContracts
import androidx.appcompat.app.AppCompatActivity
import androidx.core.content.ContextCompat
import java.io.File
import java.net.URLEncoder

/**
 * v0.3 — Generador de enlaces + conmutador de VPN de prueba.
 *
 * La seccion de VPN arranca y para [VpnTunnelService]. Todavia NO hay tunel real:
 * solo se comprueba el ciclo de vida (permiso, servicio en primer plano,
 * notificacion, estado).
 */
class MainActivity : AppCompatActivity() {

    private lateinit var etNombre: EditText
    private lateinit var etHost: EditText
    private lateinit var etPuerto: EditText
    private lateinit var etUuid: EditText
    private lateinit var etPbk: EditText
    private lateinit var etSid: EditText
    private lateinit var etSni: EditText
    private lateinit var tvEstado: TextView
    private lateinit var tvEnlace: TextView
    private lateinit var btnCopiar: Button

    private lateinit var tvVpnEstado: TextView
    private lateinit var btnVpn: Button
    private lateinit var btnApps: Button
    private lateinit var tvAppsResumen: TextView
    private lateinit var cbAnuncios: CheckBox
    private lateinit var etImportar: EditText
    private lateinit var btnImportar: Button
    private lateinit var btnRegistro: Button

    private val uuidRe = Regex("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
    private val pbkRe = Regex("^[A-Za-z0-9_-]{43}$")
    private val sidRe = Regex("^[0-9a-fA-F]{0,16}$")

    // Peticion del consentimiento de VPN que muestra Android.
    private val lanzadorVpn =
        registerForActivityResult(ActivityResultContracts.StartActivityForResult()) { resultado ->
            if (resultado.resultCode == RESULT_OK) {
                arrancarServicio(true)
            } else {
                Toast.makeText(this, "Permiso de VPN denegado", Toast.LENGTH_SHORT).show()
            }
        }

    private val receptorEstado = object : BroadcastReceiver() {
        override fun onReceive(contexto: Context?, intent: Intent?) {
            val activo = intent?.getBooleanExtra(VpnTunnelService.EXTRA_ACTIVE, false) ?: false
            pintarEstadoVpn(activo)
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        etNombre = findViewById(R.id.etNombre)
        etHost = findViewById(R.id.etHost)
        etPuerto = findViewById(R.id.etPuerto)
        etUuid = findViewById(R.id.etUuid)
        etPbk = findViewById(R.id.etPbk)
        etSid = findViewById(R.id.etSid)
        etSni = findViewById(R.id.etSni)
        tvEstado = findViewById(R.id.tvEstado)
        tvEnlace = findViewById(R.id.tvEnlace)
        btnCopiar = findViewById(R.id.btnCopiar)
        tvVpnEstado = findViewById(R.id.tvVpnEstado)
        btnVpn = findViewById(R.id.btnVpn)
        btnApps = findViewById(R.id.btnApps)
        tvAppsResumen = findViewById(R.id.tvAppsResumen)
        cbAnuncios = findViewById(R.id.cbAnuncios)
        etImportar = findViewById(R.id.etImportar)
        btnImportar = findViewById(R.id.btnImportar)
        btnRegistro = findViewById(R.id.btnRegistro)

        etPuerto.setText("443")
        etSni.setText("www.microsoft.com")

        cargar()

        val observador = object : TextWatcher {
            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
            override fun afterTextChanged(s: Editable?) {
                actualizar()
            }
        }

        listOf(etNombre, etHost, etPuerto, etUuid, etPbk, etSid, etSni).forEach {
            it.addTextChangedListener(observador)
        }

        btnCopiar.setOnClickListener {
            val enlace = construir()
            if (enlace == null) return@setOnClickListener
            val cm = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
            cm.setPrimaryClip(ClipData.newPlainText("enlace vless", enlace))
            Toast.makeText(this, "Enlace copiado al portapapeles", Toast.LENGTH_SHORT).show()
        }

        btnVpn.setOnClickListener {
            if (VpnTunnelService.activo) {
                arrancarServicio(false)
            } else {
                pedirNotificaciones()
                val permiso = VpnService.prepare(this)
                if (permiso != null) lanzadorVpn.launch(permiso) else arrancarServicio(true)
            }
        }

        btnApps.setOnClickListener {
            startActivity(Intent(this, AppsActivity::class.java))
        }

        btnImportar.setOnClickListener {
            importarEnlace()
        }

        btnRegistro.setOnClickListener {
            verRegistro()
        }

        cbAnuncios.isChecked = getSharedPreferences("ajustes", MODE_PRIVATE)
            .getBoolean("bloquearAnuncios", true)
        cbAnuncios.setOnCheckedChangeListener { _, marcado ->
            getSharedPreferences("ajustes", MODE_PRIVATE).edit()
                .putBoolean("bloquearAnuncios", marcado)
                .apply()
        }

        actualizar()
        pintarEstadoVpn(VpnTunnelService.activo)
        pintarResumenApps()
    }

    override fun onStart() {
        super.onStart()
        ContextCompat.registerReceiver(
            this,
            receptorEstado,
            IntentFilter(VpnTunnelService.ACTION_STATE),
            ContextCompat.RECEIVER_NOT_EXPORTED
        )
        pintarEstadoVpn(VpnTunnelService.activo)
    }

    override fun onStop() {
        super.onStop()
        try {
            unregisterReceiver(receptorEstado)
        } catch (e: Exception) {
            // no estaba registrado
        }
    }

    override fun onResume() {
        super.onResume()
        pintarResumenApps()
    }

    private fun pintarResumenApps() {
        val n = getSharedPreferences("apps", MODE_PRIVATE)
            .getStringSet("seleccion", emptySet())?.size ?: 0
        tvAppsResumen.text =
            if (n == 0) "Apps con VPN: todas" else "Apps con VPN: $n marcada(s)"
    }

    // ------------------------------------------------------------------ VPN

    private fun arrancarServicio(conectar: Boolean) {
        val i = Intent(this, VpnTunnelService::class.java).setAction(
            if (conectar) VpnTunnelService.ACTION_CONNECT else VpnTunnelService.ACTION_DISCONNECT
        )
        if (conectar) {
            ContextCompat.startForegroundService(this, i)
        } else {
            startService(i)
        }
        pintarEstadoVpn(conectar)
    }

    private fun pintarEstadoVpn(activo: Boolean) {
        tvVpnEstado.text = if (activo) "VPN activa" else "VPN desactivada"
        tvVpnEstado.setTextColor(if (activo) 0xFF34D399.toInt() else 0xFF8B9BB0.toInt())
        btnVpn.text = if (activo) "Desconectar" else "Conectar VPN"
    }

    private fun pedirNotificaciones() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU &&
            checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
        ) {
            requestPermissions(arrayOf(Manifest.permission.POST_NOTIFICATIONS), 1)
        }
    }

    /** Muestra el registro de sing-box para poder diagnosticar en el movil. */
    private fun verRegistro() {
        val archivo = File(filesDir, "singbox.log")
        val texto = try {
            if (archivo.exists()) {
                archivo.readText().takeLast(12000)
            } else {
                "Todavia no hay registro.\nConecta la VPN y vuelve a intentarlo."
            }
        } catch (e: Exception) {
            "No se pudo leer el registro: ${e.message}"
        }

        val vista = ScrollView(this).apply {
            addView(
                TextView(this@MainActivity).apply {
                    text = texto
                    textSize = 9f
                    setTextIsSelectable(true)
                    setPadding(24, 24, 24, 24)
                }
            )
        }

        AlertDialog.Builder(this)
            .setTitle("Registro de sing-box")
            .setView(vista)
            .setPositiveButton("Compartir") { _, _ ->
                val i = Intent(Intent.ACTION_SEND).apply {
                    type = "text/plain"
                    putExtra(Intent.EXTRA_TEXT, texto)
                }
                startActivity(Intent.createChooser(i, "Enviar registro"))
            }
            .setNegativeButton("Cerrar", null)
            .show()
    }

    // ---------------------------------------------------------------- datos

    /** Rellena el formulario a partir de un enlace vless:// pegado. */
    private fun importarEnlace() {
        val texto = etImportar.text.toString().trim()
        val m = Regex("^vless://([^@]+)@(\\[[^\\]]+\\]|[^:]+):(\\d+)\\?([^#]*)(?:#(.*))?$").find(texto)
        if (m == null) {
            Toast.makeText(this, "No parece un enlace vless:// valido", Toast.LENGTH_SHORT).show()
            return
        }

        val uuid = m.groupValues[1]
        val host = m.groupValues[2].removePrefix("[").removeSuffix("]")
        val puerto = m.groupValues[3]
        val query = m.groupValues[4]
        val fragmento = m.groupValues[5]

        fun param(nombre: String): String {
            for (parte in query.split("&")) {
                val i = parte.indexOf('=')
                if (i > 0 && parte.substring(0, i) == nombre) return parte.substring(i + 1)
            }
            return ""
        }

        etUuid.setText(uuid)
        etHost.setText(host)
        etPuerto.setText(puerto)
        etPbk.setText(param("pbk"))
        etSid.setText(param("sid"))
        etSni.setText(param("sni").ifEmpty { "www.microsoft.com" })
        if (fragmento.isNotEmpty()) {
            try {
                etNombre.setText(java.net.URLDecoder.decode(fragmento, "UTF-8"))
            } catch (e: Exception) {
                etNombre.setText(fragmento)
            }
        }
        etImportar.setText("")
        Toast.makeText(this, "Enlace importado", Toast.LENGTH_SHORT).show()
    }

    private fun datos(): List<String> = listOf(
        etNombre.text.toString().trim(),
        etHost.text.toString().trim(),
        etPuerto.text.toString().trim(),
        etUuid.text.toString().trim(),
        etPbk.text.toString().trim(),
        etSid.text.toString().trim(),
        etSni.text.toString().trim()
    )

    private fun errores(d: List<String>): List<String> {
        val e = mutableListOf<String>()
        // Kotlin solo permite desestructurar List hasta 5 elementos: acceso por indice.
        val host = d[1]
        val puerto = d[2]
        val uuid = d[3]
        val pbk = d[4]
        val sid = d[5]
        val sni = d[6]

        if (host.isEmpty()) e.add("Falta la IP o el dominio del servidor.")
        if (puerto.toIntOrNull()?.let { it in 1..65535 } != true)
            e.add("El puerto debe estar entre 1 y 65535.")
        if (!uuidRe.matches(uuid))
            e.add("El UUID no tiene el formato correcto (8-4-4-4-12).")
        if (!pbkRe.matches(pbk))
            e.add("La clave publica debe tener 43 caracteres; ahora tiene ${pbk.length}.")
        if (!sidRe.matches(sid))
            e.add("El shortId debe ser hexadecimal, 16 caracteres como maximo.")
        else if (sid.length % 2 != 0)
            e.add("El shortId debe tener un numero par de caracteres.")
        if (sni.isEmpty()) e.add("Falta el SNI (por ejemplo www.microsoft.com).")
        return e
    }

    private fun construir(): String? {
        val d = datos()
        if (errores(d).isNotEmpty()) return null
        val nombre = d[0]
        val host = d[1]
        val puerto = d[2]
        val uuid = d[3]
        val pbk = d[4]
        val sid = d[5]
        val sni = d[6]

        val etiqueta = URLEncoder.encode(if (nombre.isEmpty()) "mi-vps" else nombre, "UTF-8")
            .replace("+", "%20")

        return buildString {
            append("vless://").append(uuid).append('@').append(host).append(':').append(puerto)
            append("?encryption=none")
            append("&flow=xtls-rprx-vision")
            append("&security=reality")
            append("&sni=").append(sni)
            append("&fp=chrome")
            append("&pbk=").append(pbk)
            append("&sid=").append(sid)
            append("&type=tcp&headerType=none")
            append('#').append(etiqueta)
        }
    }

    // ------------------------------------------------------------- interfaz

    private fun actualizar() {
        val d = datos()
        val e = errores(d)
        val enlace = if (e.isEmpty()) construir() else null

        if (e.isEmpty()) {
            tvEstado.text = "Datos correctos"
            tvEstado.setTextColor(0xFF34D399.toInt())
        } else {
            tvEstado.text = e.joinToString("\n") { "• $it" }
            tvEstado.setTextColor(0xFFF87171.toInt())
        }

        tvEnlace.text = enlace ?: "—"
        btnCopiar.isEnabled = enlace != null
        guardar(d)
    }

    // ------------------------------------------------------- persistencia

    private fun guardar(d: List<String>) {
        val p = getSharedPreferences("vless", MODE_PRIVATE).edit()
        p.putString("nombre", d[0])
        p.putString("host", d[1])
        p.putString("puerto", d[2])
        p.putString("uuid", d[3])
        p.putString("pbk", d[4])
        p.putString("sid", d[5])
        p.putString("sni", d[6])
        p.apply()
    }

    private fun cargar() {
        val p = getSharedPreferences("vless", MODE_PRIVATE)
        etNombre.setText(p.getString("nombre", ""))
        etHost.setText(p.getString("host", ""))
        etPuerto.setText(p.getString("puerto", "443"))
        etUuid.setText(p.getString("uuid", ""))
        etPbk.setText(p.getString("pbk", ""))
        etSid.setText(p.getString("sid", ""))
        etSni.setText(p.getString("sni", "www.microsoft.com"))
    }
}
